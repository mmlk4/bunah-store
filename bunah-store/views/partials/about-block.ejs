<section class="about-block" aria-labelledby="about-h-<%= typeof uid !== 'undefined' ? uid : 'x' %>">
  <div class="about-head">
    <img src="<%= S.logo || '/img/logo.png' %>" alt="" width="64" height="64">
    <div>
      <span class="eyebrow">تعرّف على الجهة المستفيدة من تبرعك</span>
      <h2 id="about-h-<%= typeof uid !== 'undefined' ? uid : 'x' %>"><%= S.name %></h2>
    </div>
  </div>
  <p><%= S.about %></p>
  <div class="vm-grid">
    <div class="vm vm-vision"><h3>الرؤية</h3><p><%= S.vision %></p></div>
    <div class="vm vm-mission"><h3>الرسالة</h3><p><%= S.mission %></p></div>
  </div>
  <% if ((S.stats || []).length) { %>
  <div class="mini-stats">
    <% S.stats.forEach(function (st) { %><div><b><%= st.value %></b><span><%= st.label %></span></div><% }) %>
  </div>
  <% } %>
  <ul class="trust-list">
    <li>جمعية أهلية مرخّصة من المركز الوطني لتنمية القطاع غير الربحي برقم <b><%= S.license %></b></li>
    <li>يُقاس أثر برامجنا بمقاييس قبلية وبعدية، وتُنشر النتائج في تقاريرنا</li>
    <li>تبرعك يذهب للفرصة التي اخترتها، ويصلك إيصال برقم الطلب</li>
  </ul>
</section>
