<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' | ' : '' %><%= S.name %></title>
<meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : (S.tagline + ' — ' + (S.mission || '')) %>">
<meta property="og:title" content="<%= title || S.name %>">
<meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : S.tagline %>">
<% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
<meta name="theme-color" content="#514680">
<link rel="icon" href="/img/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
