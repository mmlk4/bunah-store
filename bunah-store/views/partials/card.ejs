<article class="opp-card<%= o.completed || o.status === 'completed' ? ' is-done' : '' %>" data-category="<%= o.category %>">
  <a class="opp-media" href="/o/<%= o.slug %>" tabindex="-1" aria-hidden="true">
    <img src="<%= (o.images || [])[0] || '/img/seed/ev_S10.jpg' %>" alt="" loading="lazy">
    <% if (o.completed || o.status === 'completed') { %><span class="badge badge-done">اكتمل التمويل</span><% } else if (o.featured) { %><span class="badge">فرصة مميزة</span><% } %>
  </a>
  <div class="opp-body">
    <span class="eyebrow"><%= o.category %></span>
    <h3><a href="/o/<%= o.slug %>"><%= o.title %></a></h3>
    <p class="muted"><%= o.summary %></p>
    <% if (o.target > 0) { %>
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= o.pct %>" aria-label="نسبة التمويل">
      <span style="width:<%= o.pct %>%"></span>
    </div>
    <div class="progress-meta">
      <span><b><%= o.pct %>%</b> مُموَّل</span>
      <span>المتبقي <b><%= money(o.remaining) %></b> ريال</span>
    </div>
    <% } else { %>
    <div class="progress-meta open"><span>مساهمة مفتوحة — كل ريال يقرّبنا من الهدف</span></div>
    <% } %>
    <div class="opp-actions">
      <a class="btn btn-primary" href="/o/<%= o.slug %>"><%= (o.completed || o.status === 'completed') ? 'تفاصيل المشروع' : 'تبرّع الآن' %></a>
      <% if (!(o.completed || o.status === 'completed')) { %>
      <button class="btn btn-outline" type="button" data-quick-add data-id="<%= o.id %>" data-title="<%= o.title %>" data-amount="<%= (o.presets || [100])[0] %>" data-image="<%= (o.images || [])[0] || '' %>">أضف <%= money((o.presets || [100])[0]) %> ر.س للسلة</button>
      <% } %>
    </div>
  </div>
</article>
