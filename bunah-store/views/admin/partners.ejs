<%- include('_top') %>
<header class="ph"><h1>الشركاء</h1></header>
<section class="panel">
  <h2>إضافة شريك</h2>
  <form class="filters" method="post" action="/admin/partners" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="f"><span>اسم الجهة</span><input name="name" required maxlength="120"></label>
    <label class="f"><span>الشعار (PNG بخلفية شفافة أو بيضاء)</span><input type="file" name="logo" required accept="image/png,image/jpeg,image/webp"></label>
    <button class="b b-p" type="submit">إضافة</button>
  </form>
</section>
<section class="panel">
  <h2>الشركاء الحاليون (<%= list.length %>)</h2>
  <p class="muted small">يظهرون في المتجر بهذا الترتيب، من اليمين إلى اليسار.</p>
  <div class="partner-admin">
    <% list.forEach(function (p, i) { %>
    <div class="pa-item">
      <div class="pa-logo"><img src="<%= p.logo %>" alt="<%= p.name %>"></div>
      <b><%= p.name %></b>
      <div class="pa-actions">
        <form method="post" action="/admin/partners/<%= p.id %>/move"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="up"><button class="b b-s b-ghost" <%= i === 0 ? 'disabled' : '' %> aria-label="تقديم">→</button></form>
        <form method="post" action="/admin/partners/<%= p.id %>/move"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="down"><button class="b b-s b-ghost" <%= i === list.length - 1 ? 'disabled' : '' %> aria-label="تأخير">←</button></form>
        <form method="post" action="/admin/partners/<%= p.id %>/delete" data-confirm="حذف شعار <%= p.name %>؟"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="b b-s b-danger-o">حذف</button></form>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<%- include('_bottom') %>
