<%- include('_top') %>
<div class="auth">
  <form class="auth-card" method="post" action="/admin/login">
    <img src="/img/logo.png" alt="" width="72" height="72">
    <h1>تسجيل الدخول</h1>
    <p class="muted">لوحة تحكم متجر <%= S.name %></p>
    <% if (error) { %><p class="err"><%= error %></p><% } %>
    <label class="f"><span>اسم المستخدم</span><input name="username" required autocomplete="username"></label>
    <label class="f"><span>كلمة المرور</span><input name="password" type="password" required autocomplete="current-password"></label>
    <button class="b b-p b-block" type="submit">دخول</button>
  </form>
</div>
<%- include('_bottom') %>
