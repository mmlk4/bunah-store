<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= title %> | لوحة تحكم <%= S.name %></title>
<link rel="icon" href="/img/logo.png">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
<% if (typeof adminUser !== 'undefined') { %>
<aside class="side">
  <a class="side-brand" href="/admin"><img src="/img/logo-white.png" alt=""><span>لوحة التحكم</span></a>
  <nav>
    <a href="/admin" class="<%= path === '/admin' ? 'on' : '' %>">الرئيسية</a>
    <a href="/admin/opportunities" class="<%= path.indexOf('/admin/opportunities') === 0 ? 'on' : '' %>">فرص التبرع</a>
    <a href="/admin/donations" class="<%= path.indexOf('/admin/donations') === 0 ? 'on' : '' %>">التبرعات</a>
    <a href="/admin/partners" class="<%= path.indexOf('/admin/partners') === 0 ? 'on' : '' %>">الشركاء</a>
    <a href="/admin/settings" class="<%= path.indexOf('/admin/settings') === 0 ? 'on' : '' %>">الإعدادات</a>
  </nav>
  <div class="side-foot">
    <a href="/" target="_blank" rel="noopener">عرض المتجر ↗</a>
    <form method="post" action="/admin/logout"><button type="submit">تسجيل الخروج (<%= adminUser %>)</button></form>
  </div>
</aside>
<% } %>
<main class="admin-main">
<% if (flash) { %><div class="flash" role="status"><%= flash %></div><% } %>
