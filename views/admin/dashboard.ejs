<%- include('_top') %>
<header class="ph"><h1>نظرة عامة</h1><a class="b b-p" href="/admin/opportunities/new">+ فرصة جديدة</a></header>
<% if (!pay.enabled) { %>
<div class="notice">الدفع الإلكتروني غير مفعّل حاليًا: <b><%= pay.label %></b>. يرى المتبرعون بيانات التحويل البنكي، وتعتمد أنت التبرعات يدويًا من صفحة التبرعات.</div>
<% } else { %>
<div class="notice ok">بوابة الدفع: <b><%= pay.label %></b></div>
<% } %>
<section class="kpis">
  <div class="kpi"><span>إجمالي التبرعات المعتمدة</span><b><%= money(stats.raised) %></b><small>ريال</small></div>
  <div class="kpi"><span>آخر 30 يومًا</span><b><%= money(stats.raised30) %></b><small>ريال</small></div>
  <div class="kpi"><span>عدد التبرعات المعتمدة</span><b><%= stats.count %></b><small>تبرع</small></div>
  <div class="kpi <%= stats.pendingBank ? 'warn' : '' %>"><span>تحويلات بانتظار الاعتماد</span><b><%= stats.pendingBank %></b><small><a href="/admin/donations?status=pending&method=bank">مراجعة</a></small></div>
  <div class="kpi"><span>الفرص المنشورة</span><b><%= stats.active %></b><small>فرصة</small></div>
</section>

<div class="grid2">
  <section class="panel">
    <h2>التبرعات المعتمدة — آخر 14 يومًا</h2>
    <% var max = Math.max.apply(null, days.map(function (d) { return d.total; }).concat([1])); %>
    <div class="bars" role="img" aria-label="رسم بياني للتبرعات اليومية خلال آخر 14 يومًا">
      <% days.forEach(function (d) { %>
      <div class="bar-col" title="<%= d.day %>: <%= money(d.total) %> ريال">
        <span class="bar-v"><%= d.total ? money(d.total) : '' %></span>
        <div class="bar" style="height:<%= Math.round(d.total / max * 140) + 2 %>px"></div>
        <span class="bar-l"><%= d.day.slice(8) %></span>
      </div>
      <% }) %>
    </div>
  </section>
  <section class="panel">
    <h2>تقدّم الفرص</h2>
    <ul class="plist">
      <% opps.forEach(function (o) { %>
      <li>
        <div class="pl-top"><a href="/admin/opportunities/<%= o.id %>"><%= o.title %></a><span><%= o.target ? o.pct + '%' : 'مفتوحة' %></span></div>
        <div class="pbar"><span style="width:<%= o.pct %>%"></span></div>
        <small><%= money(o.raised) %> / <%= o.target ? money(o.target) : '—' %> ريال</small>
      </li>
      <% }) %>
    </ul>
  </section>
</div>

<section class="panel">
  <div class="panel-head"><h2>أحدث الطلبات</h2><a href="/admin/donations">كل التبرعات</a></div>
  <%- include('_donation-table', { list: recent, compact: true }) %>
</section>
<%- include('_bottom') %>
