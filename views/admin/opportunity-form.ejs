<%- include('_top') %>
<% var isNew = o.id === 'new'; %>
<header class="ph"><h1><%= isNew ? 'فرصة جديدة' : 'تعديل الفرصة' %></h1>
  <% if (!isNew && (o.status === 'active' || o.status === 'completed')) { %><a class="b b-o" href="/o/<%= o.slug %>" target="_blank" rel="noopener">عرض في المتجر ↗</a><% } %>
</header>
<form class="form-grid" method="post" action="/admin/opportunities/<%= o.id %>" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="col-main">
    <section class="panel">
      <h2>المحتوى</h2>
      <label class="f"><span>عنوان الفرصة *</span><input name="title" required maxlength="140" value="<%= o.title || '' %>"></label>
      <label class="f"><span>وصف مختصر (يظهر في البطاقة)</span><textarea name="summary" rows="2" maxlength="400"><%= o.summary || '' %></textarea></label>
      <label class="f"><span>تفاصيل المشروع</span><textarea name="description" rows="7" maxlength="6000"><%= o.description || '' %></textarea></label>
      <label class="f"><span>الأثر المتوقع</span><textarea name="impact" rows="3" maxlength="1500"><%= o.impact || '' %></textarea></label>
      <div class="row2">
        <label class="f"><span>الفئة المستفيدة</span><input name="beneficiaries" maxlength="300" value="<%= o.beneficiaries || '' %>"></label>
        <label class="f"><span>مدة التنفيذ</span><input name="duration" maxlength="60" value="<%= o.duration || '' %>" placeholder="مثال: 3 أشهر"></label>
      </div>
    </section>
    <section class="panel">
      <h2>الصور</h2>
      <% if ((o.images || []).length) { %>
      <div class="img-list">
        <% o.images.forEach(function (src, i) { %>
        <label class="img-item"><img src="<%= src %>" alt=""><span><input type="checkbox" name="keepImages" value="<%= src %>" checked> إبقاء<%= i === 0 ? ' (الرئيسية)' : '' %></span></label>
        <% }) %>
      </div>
      <% } %>
      <label class="f"><span>إضافة صور (JPG / PNG / WEBP، حتى 4MB لكل صورة)</span><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple></label>
      <p class="muted small">الصورة الأولى تظهر في بطاقة الفرصة. أزل علامة «إبقاء» لحذف صورة.</p>
    </section>
  </div>
  <div class="col-side">
    <section class="panel">
      <h2>النشر</h2>
      <label class="f"><span>الحالة</span><select name="status">
        <% [['active','منشورة'],['draft','مسودة (غير ظاهرة)'],['completed','مكتملة (تظهر كإنجاز)'],['hidden','مخفية']].forEach(function (s) { %><option value="<%= s[0] %>" <%= o.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %>
      </select></label>
      <label class="f"><span>المجال</span><select name="category">
        <% categories.forEach(function (c) { %><option <%= o.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select></label>
      <label class="f"><span>الترتيب في المتجر</span><input type="number" name="order" value="<%= o.order || 0 %>"></label>
      <label class="chk"><input type="checkbox" name="featured" <%= o.featured ? 'checked' : '' %>> فرصة مميزة</label>
      <label class="f"><span>الرابط المختصر</span><input name="slug" dir="ltr" value="<%= o.slug || '' %>" placeholder="يُولَّد من العنوان"></label>
    </section>
    <section class="panel">
      <h2>المبالغ</h2>
      <label class="f"><span>المبلغ المستهدف (ريال) — 0 = مساهمة مفتوحة</span><input type="number" min="0" name="target" value="<%= o.target || 0 %>"></label>
      <label class="f"><span>مدعوم مسبقًا خارج المتجر (ريال)</span><input type="number" min="0" name="raisedOffset" value="<%= o.raisedOffset || 0 %>"></label>
      <label class="f"><span>مبالغ التبرع المقترحة (افصل بفاصلة)</span><input name="presets" dir="ltr" value="<%= (o.presets || []).join(', ') %>"></label>
      <% if (!isNew) { %><p class="muted small">المجموع الحالي: <b><%= money(o.raised) %></b> ريال (<%= o.pct %>%) · المتبقي: <b><%= money(o.remaining) %></b></p><% } %>
    </section>
    <button class="b b-p b-block" type="submit">حفظ</button>
  </div>
</form>
<% if (!isNew) { %>
<form method="post" action="/admin/opportunities/<%= o.id %>/delete" class="danger-zone" data-confirm="حذف الفرصة «<%= o.title %>»؟ إن كانت عليها تبرعات فستُخفى بدل الحذف.">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button class="b b-danger" type="submit">حذف الفرصة</button>
</form>
<% } %>
<%- include('_bottom') %>
