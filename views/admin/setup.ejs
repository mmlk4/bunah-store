<%- include('_top') %>
<div class="auth">
  <form class="auth-card" method="post" action="/admin/setup">
    <img src="/img/logo.png" alt="" width="72" height="72">
    <h1>إعداد حساب المدير</h1>
    <p class="muted">تظهر هذه الصفحة مرة واحدة فقط، قبل إنشاء أول حساب.</p>
    <% if (error) { %><p class="err"><%= error %></p><% } %>
    <% if (process.env.SETUP_TOKEN) { %><label class="f"><span>رمز الإعداد (من ملف .env)</span><input name="token" required></label><% } %>
    <label class="f"><span>اسم المستخدم</span><input name="username" required minlength="3" autocomplete="username"></label>
    <label class="f"><span>كلمة المرور (10 أحرف على الأقل)</span><input name="password" type="password" required minlength="10" autocomplete="new-password"></label>
    <button class="b b-p b-block" type="submit">إنشاء الحساب</button>
  </form>
</div>
<%- include('_bottom') %>
