<%- include('partials/header') %>
<link rel="stylesheet" href="https://cdn.moyasar.com/mpf/1.15.0/moyasar.css">
<section class="wrap page-narrow">
  <h1>إتمام الدفع</h1>
  <div class="cart-layout">
    <div class="card summary">
      <h2 class="h-sm">ملخص التبرع</h2>
      <p class="muted">رقم الطلب: <b dir="ltr"><%= dn.ref %></b></p>
      <ul class="summary-list">
        <% dn.items.forEach(function (it) { %><li><span><%= it.title %></span><b><%= money(it.amount) %> ر.س</b></li><% }) %>
      </ul>
      <div class="total-row"><span>الإجمالي</span><b><%= money(dn.total) %> ريال</b></div>
      <a class="muted small" href="/bank/<%= dn.ref %>">أفضّل التحويل البنكي</a>
    </div>
    <div class="card">
      <div class="mysr-form"></div>
      <p class="pay-note">تتم معالجة الدفع عبر بوابة ميسّر المرخّصة من البنك المركزي السعودي، ولا تصل بيانات بطاقتك إلى الجمعية.</p>
    </div>
  </div>
</section>
<script id="pay-config" type="application/json"><%- JSON.stringify(cfg).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.moyasar.com/mpf/1.15.0/moyasar.js"></script>
<script src="/js/pay.js"></script>
<%- include('partials/footer') %>
