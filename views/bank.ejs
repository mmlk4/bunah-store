<%- include('partials/header') %>
<section class="wrap page-narrow">
  <div class="card center-card" data-clear-cart>
    <span class="eyebrow">تم تسجيل طلب التبرع</span>
    <h1>أكمل تبرعك بالتحويل البنكي</h1>
    <p class="lead-dark">حوّل مبلغ <b><%= money(dn.total) %> ريال</b> إلى الحساب الرسمي للجمعية، واكتب رقم الطلب في وصف التحويل.</p>
    <div class="ref-box"><span>رقم الطلب</span><b dir="ltr"><%= dn.ref %></b><button class="btn btn-outline btn-sm" type="button" data-copy="<%= dn.ref %>">نسخ</button></div>
    <div class="bank-box">
      <div><span>اسم الحساب</span><b><%= S.accountName || S.name %></b></div>
      <% if (S.bankName) { %><div><span>البنك</span><b><%= S.bankName %></b></div><% } %>
      <div><span>الآيبان</span><b dir="ltr"><%= (S.iban || '').replace(/(.{4})/g, '$1 ').trim() %></b><button class="btn btn-outline btn-sm" type="button" data-copy="<%= S.iban %>">نسخ</button></div>
    </div>
    <ul class="summary-list">
      <% dn.items.forEach(function (it) { %><li><span><%= it.title %></span><b><%= money(it.amount) %> ر.س</b></li><% }) %>
    </ul>
    <p class="muted">بعد التحويل، أرسل صورة الإيصال مع رقم الطلب <% if (S.whatsapp) { %>عبر <a href="https://wa.me/<%= S.whatsapp %>?text=<%= encodeURIComponent('إيصال تحويل لطلب التبرع رقم ' + dn.ref) %>" target="_blank" rel="noopener">واتساب</a><% } else { %>إلى <%= S.email %><% } %>، وسيُعتمد تبرعك ويُضاف إلى الفرصة.</p>
    <a class="btn btn-primary" href="/">العودة للرئيسية</a>
  </div>
</section>
<%- include('partials/footer') %>
