<%- include('partials/header') %>
<section class="wrap page-narrow">
  <h1>سلة التبرعات</h1>
  <div class="cart-layout">
    <div>
      <div class="cart-items" data-cart-items aria-live="polite"></div>
      <div class="cart-empty" data-cart-empty hidden>
        <p>السلة فارغة.</p>
        <a class="btn btn-primary" href="/#opportunities">تصفّح فرص التبرع</a>
      </div>
    </div>
    <form class="checkout card" method="post" action="/checkout" data-checkout-form data-min="<%= Number(MIN_DONATION) %>">
      <h2 class="h-sm">بيانات المتبرع</h2>
      <input type="hidden" name="items" data-items-field>
      <label class="field"><span>الاسم</span><input name="name" maxlength="80" autocomplete="name"></label>
      <label class="field"><span>رقم الجوال <i>(لاستلام الإيصال)</i></span><input name="phone" required inputmode="tel" autocomplete="tel" placeholder="05XXXXXXXX" dir="ltr" pattern="(\+?966|0)?5[0-9]{8}"></label>
      <label class="field"><span>البريد الإلكتروني <i>(اختياري)</i></span><input name="email" type="email" maxlength="120" autocomplete="email" dir="ltr"></label>
      <label class="check"><input type="checkbox" name="anonymous"> <span>تبرّع باسم «فاعل خير»</span></label>
      <details class="gift">
        <summary>إهداء التبرع لشخص آخر</summary>
        <label class="field"><span>اسم المُهدى إليه</span><input name="giftTo" maxlength="80"></label>
        <label class="field"><span>جواله (اختياري)</span><input name="giftPhone" inputmode="tel" dir="ltr"></label>
      </details>
      <div class="total-row"><span>الإجمالي</span><b><span data-cart-total>0</span> ريال</b></div>
      <button class="btn btn-primary btn-lg btn-block" type="submit" data-checkout-btn><%= paymentEnabled ? 'المتابعة للدفع' : 'تأكيد التبرع' %></button>
      <p class="pay-note"><%= paymentEnabled ? 'الدفع آمن عبر بوابة دفع مرخّصة: مدى، فيزا، ماستركارد، Apple Pay.' : 'سيظهر لك بعد التأكيد رقم طلب وبيانات الحساب البنكي لإتمام التبرع بالتحويل.' %></p>
      <p class="form-error" data-error hidden></p>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
