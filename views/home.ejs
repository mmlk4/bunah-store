<%- include('partials/header') %>
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="eyebrow gold"><%= S.tagline %></span>
      <h1><%= S.heroTitle || S.name %></h1>
      <p class="lead"><%= S.heroText %></p>
      <div class="hero-actions">
        <a class="btn btn-gold btn-lg" href="#opportunities">تصفّح فرص التبرع</a>
        <a class="btn btn-ghost-light btn-lg" href="#about">تعرّف على الجمعية</a>
      </div>
      <% if (totals.target > 0) { %>
      <div class="hero-progress">
        <div class="progress progress-light"><span style="width:<%= Math.min(100, Math.round(totals.raised / totals.target * 100)) %>%"></span></div>
        <p>جُمع <b><%= money(totals.raised) %></b> ريال من أصل <b><%= money(totals.target) %></b> ريال لفرص هذا العام</p>
      </div>
      <% } %>
    </div>
    <div class="hero-media">
      <img src="<%= S.heroImage %>" alt="مربون مشاركون في أحد برامج الجمعية">
      <img class="leaf" src="/img/leaf.png" alt="" aria-hidden="true">
    </div>
  </div>
</section>

<section class="stats-band" id="impact" aria-label="أثرنا بالأرقام">
  <div class="wrap stats-grid">
    <% (S.stats || []).forEach(function (st) { %>
    <div class="stat"><b><%= st.value %></b><span><%= st.label %></span></div>
    <% }) %>
  </div>
</section>

<section class="section" id="opportunities">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">فرص التبرع</span>
        <h2>اختر الأثر الذي تريد أن تصنعه</h2>
      </div>
      <div class="chips" role="tablist" aria-label="تصفية حسب المجال">
        <button class="chip is-on" type="button" data-filter="all" role="tab" aria-selected="true">الكل</button>
        <% categories.forEach(function (c) { %>
        <button class="chip" type="button" data-filter="<%= c %>" role="tab" aria-selected="false"><%= c %></button>
        <% }) %>
      </div>
    </div>
    <div class="opp-grid" data-opp-grid>
      <% opps.filter(function (o) { return o.status === 'active' && !o.completed; }).forEach(function (o) { %><%- include('partials/card', { o: o }) %><% }) %>
    </div>
    <p class="empty" data-empty hidden>لا توجد فرص في هذا المجال حاليًا.</p>
    <% var done = opps.filter(function (o) { return o.status === 'completed' || o.completed; }); if (done.length) { %>
    <h3 class="sub-head">فرص اكتمل تمويلها — شكرًا لداعميها</h3>
    <div class="opp-grid opp-grid-done">
      <% done.forEach(function (o) { %><%- include('partials/card', { o: o }) %><% }) %>
    </div>
    <% } %>
  </div>
</section>

<section class="section section-soft" id="about">
  <div class="wrap about-grid">
    <div>
      <span class="eyebrow">من نحن</span>
      <h2><%= S.name %></h2>
      <p class="lead-dark"><%= S.about %></p>
      <div class="vm-grid">
        <div class="vm vm-vision"><h3>الرؤية</h3><p><%= S.vision %></p></div>
        <div class="vm vm-mission"><h3>الرسالة</h3><p><%= S.mission %></p></div>
      </div>
    </div>
    <div class="values">
      <h3>قيمنا</h3>
      <ul>
        <% (S.values || []).forEach(function (v, i) { %>
        <li><span class="num"><%= String(i + 1).padStart(2, '0') %></span><div><b><%= v.title %></b><p><%= v.desc %></p></div></li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap how">
    <div class="section-head"><div><span class="eyebrow">كيف نصنع الأثر</span><h2>حلقة مغلقة تقيس التغيّر</h2></div></div>
    <ol class="steps">
      <li><b>قبل البرنامج</b><span>تقييم قبلي لتشخيص الاحتياج</span></li>
      <li><b>أثناء البرنامج</b><span>تدريب تفاعلي وتطبيقات ميدانية</span></li>
      <li><b>بعد البرنامج</b><span>تقييم بعدي لقياس الأثر ونشر النتائج</span></li>
    </ol>
  </div>
</section>

<% if (partners.length) { %>
<section class="section section-soft" id="partners">
  <div class="wrap">
    <div class="section-head"><div><span class="eyebrow">شركاء النجاح</span><h2>جهات وثقت بنا وشاركتنا الأثر</h2></div></div>
    <div class="partners-grid">
      <% partners.forEach(function (p) { %><figure title="<%= p.name %>"><img src="<%= p.logo %>" alt="<%= p.name %>" loading="lazy"></figure><% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
