<%- include('partials/header') %>
<section class="wrap page-narrow">
  <div class="card center-card" data-clear-cart>
    <div class="check-icon" aria-hidden="true">✓</div>
    <% if (dn.status === 'paid') { %>
    <h1>شكرًا لك، تم استلام تبرعك</h1>
    <p class="lead-dark">جزاك الله خيرًا<%= dn.donor.name && !dn.donor.anonymous ? '، ' + dn.donor.name : '' %>. تبرعك بمبلغ <b><%= money(dn.total) %> ريال</b> أصبح جزءًا من أثر الجمعية.</p>
    <% } else { %>
    <h1>طلبك قيد التأكيد</h1>
    <p class="lead-dark">لم يصلنا تأكيد الدفع بعد. إن خُصم المبلغ فسيُعتمد تلقائيًا خلال دقائق.</p>
    <% } %>
    <div class="ref-box"><span>رقم الطلب</span><b dir="ltr"><%= dn.ref %></b></div>
    <ul class="summary-list">
      <% dn.items.forEach(function (it) { %><li><span><%= it.title %></span><b><%= money(it.amount) %> ر.س</b></li><% }) %>
    </ul>
    <% if (dn.donor.giftTo) { %><p class="muted">مُهدى إلى: <b><%= dn.donor.giftTo %></b></p><% } %>
    <div class="hero-actions center">
      <a class="btn btn-primary" href="/#opportunities">فرص أخرى</a>
      <a class="btn btn-outline" href="https://wa.me/?text=<%= encodeURIComponent('تبرّعت لـ' + S.name + '، وأدعوك للمشاركة في الأثر') %>" target="_blank" rel="noopener">ادعُ غيرك للتبرع</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
